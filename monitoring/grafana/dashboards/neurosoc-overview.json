{
  "title": "NeuroSOC Overview",
  "uid": "neurosoc-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Events processed / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(neurosoc_events_processed_total[5m])",
          "legendFormat": "events/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inference latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(neurosoc_inference_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(neurosoc_inference_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Verdicts by class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (verdict) (rate(neurosoc_verdicts_total[5m]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active sandbox sessions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "neurosoc_sandbox_active_sessions",
          "legendFormat": "active sessions",
          "refId": "A"
        },
        {
          "expr": "rate(neurosoc_sandbox_honeypot_hits_total[5m])",
          "legendFormat": "honeypot hits/sec ({{trigger_type}})",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Ingestion throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(neurosoc_ingestion_events_published_total[5m])",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Feature engine throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(neurosoc_feature_packets_processed_total[5m])",
          "legendFormat": "packets/sec",
          "refId": "A"
        },
        {
          "expr": "rate(neurosoc_feature_flows_published_total[5m])",
          "legendFormat": "flows/sec",
          "refId": "B"
        }
      ]
    }
  ]
}
