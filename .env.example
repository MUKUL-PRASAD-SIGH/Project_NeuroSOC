# ─────────────────────────────────────────────────────────────────────
# NeuroShield Environment Variables — copy to .env and fill in values.
# POSTGRES_PASSWORD, DATABASE_URL, KEYCLOAK_ADMIN_PASSWORD, and
# GRAFANA_ADMIN_PASSWORD are required by docker-compose.yml (no fallback
# default) -- `docker compose config` fails loudly if any is left unset.
# Replace every CHANGE_ME value below before anything beyond a disposable
# localhost-only stack; do not reuse these example values anywhere real.
# ─────────────────────────────────────────────────────────────────────

# --- Kafka ---
KAFKA_BOOTSTRAP=kafka:9092

# --- PostgreSQL ---
APP_ENV=local
POSTGRES_USER=ns_user
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_password
POSTGRES_DB=neuroshield
DATABASE_URL=postgresql://ns_user:CHANGE_ME_local_postgres_password@postgres:5432/neuroshield

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Ingestion ---
INGESTION_MODE=all           # 'pcap' | 'netflow' | 'bank_portal' | 'all'
INGESTION_SOURCE_ID=ingestion-service  # stable operator-assigned instance identifier; unique per sensor/deployment
DATA_DIR=/data/pcap

# --- Feature Engine ---
FLOW_TIMEOUT_SECONDS=3

# --- Inference / Decision Engine ---
MODEL_PATH=/models
SANDBOX_CONFIDENCE_THRESHOLD=0.50  # confidence >= this → sandbox
OIDC_ISSUER=http://keycloak:8080/realms/neurosoc
OIDC_AUDIENCE=neurosoc-dashboard
OIDC_REQUIRED=false  # enable after the calling client sends bearer tokens

# Dashboard build-time Keycloak sign-in config (browser-facing, so a host-reachable URL,
# not the internal "keycloak:8080" one above). Set VITE_OIDC_REQUIRED=true alongside
# OIDC_REQUIRED=true to require sign-in for a stricter demo run.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=neurosoc
VITE_KEYCLOAK_CLIENT_ID=neurosoc-dashboard
VITE_OIDC_REQUIRED=false
ENABLE_SIMULATION_API=false  # set true only for the local NovaTrust demo profile
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174
IPINFO_TOKEN=                # optional: ipinfo.io token for alert geolocation (city, country, TOR/VPN flags)
API_MAX_REQUEST_BODY_BYTES=1048576
API_RATE_LIMIT_PER_MINUTE=120
# Docker Compose local proxy network: if changing its subnet, update all three static IPs and TRUSTED_PROXY_IPS.
API_PROXY_SUBNET=172.30.0.0/24
API_PROXY_INFERENCE_IP=172.30.0.2
DASHBOARD_PROXY_IP=172.30.0.10
PORTAL_PROXY_IP=172.30.0.11
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.30.0.10,172.30.0.11
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_local_keycloak_admin_password
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_local_grafana_admin_password

# --- Sandbox ---
SANDBOX_TIMEOUT_SEC=300
# Shared secret for inference-service to call sandbox-service. Local/test may leave this blank;
# staging/production requires at least 32 randomly generated characters in both services.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_SERVICE_TOKEN=

# --- Retraining ---
RETRAIN_MIN_FEEDBACK_SAMPLES=500   # number of new feedback rows required before a retraining run triggers

# --- Reporting ---
REPORT_EMAIL=analyst@yourorg.com
REPORT_TIME=06:00
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=neuroshield@yourorg.com
SMTP_PASS=changeme

# --- Alerting ---
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Frontend ---
VITE_API_URL=http://localhost:8000
