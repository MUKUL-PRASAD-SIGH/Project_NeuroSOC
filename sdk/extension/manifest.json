{
  "manifest_version": 3,
  "name": "NeuroSOC Lens",
  "version": "0.1.0",
  "description": "Runs the NeuroSOC SDK on sites you choose, in observe-only mode, without changing the site's code. For demos and evaluations.",
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "content_scripts": [
    {
      "matches": ["https://cyreneai.com/*", "https://www.cyreneai.com/*", "https://app.cyreneai.com/*", "http://localhost:3001/*", "http://localhost:5174/*"],
      "js": ["lens-sites.js", "neurosoc.min.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cyreneai.com/*", "https://www.cyreneai.com/*", "https://app.cyreneai.com/*", "http://localhost:3001/*", "http://localhost:5174/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
