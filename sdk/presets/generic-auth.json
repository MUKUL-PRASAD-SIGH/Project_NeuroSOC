{
  "name": "Generic sign-up and login",
  "description": "Maps common sign-up and login forms on any site: a form containing a password field plus a confirm/second password is a sign-up, one password field is a login.",
  "rules": [
    { "match": { "url": "*", "event": "submit", "has": "input[type=password] ~ input[type=password], input[autocomplete=new-password]" }, "action": "account.create", "resource": { "type": "account", "id_from": "url:path" } },
    { "match": { "url": "*", "event": "submit", "has": "input[type=password]" }, "action": "auth.login", "resource": { "type": "account", "id_from": "url:path", "sensitivity": "medium" } },
    { "match": { "url": "*", "event": "click", "text": ["log out", "logout", "sign out"] }, "action": "auth.logout", "resource": { "type": "account", "id_from": "url:path" } },
    { "match": { "url": "*", "event": "submit" }, "action": "form.submit", "resource": { "type": "form", "id_from": "url:path" } }
  ]
}
