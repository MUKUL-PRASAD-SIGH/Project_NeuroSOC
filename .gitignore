# Repository dump artifacts
.repo_dump_meta.json
repo_dump.md
generate_repo_markdown.py

# Local environment files
.env
.env.local

# Python artifacts
__pycache__/
*.pyc
data/behavioral_profiles/
models/*.pt
models/*.json
!models/model_version.json
models/candidates/*
!models/candidates/.gitkeep

# JavaScript build artifacts
node_modules/
dist/
Docs/
artifacts/demo/

# Logs
*.log
tmp_logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor noise
.DS_Store
Thumbs.db
.directory
.serena/

# Documentation: only the root README.md is published
*.md
!/README.md
!/sdk/README.md
!/sdk/python/README.md
!/sdk/js/README.md
!/deployment/README.md
Docs/
docs/*
!/docs/DEMO_TEST_REPORT.md
!/docs/demo-screenshots/
!/docs/demo-screenshots/*.png
builderA/
builderB/
builderC/
builderD/

# Extra local files
.vscode/
.vite/
/package-lock.json
models/tmp*
artifacts/artifacts/

# Demo, walkthrough and dev-only scripts
# (a bare directory pattern can't be re-included per-file by git, so this ignores
# contents via the trailing /* instead of the directory itself)
dashboard/scripts/*
# ...except the production build guard vite.config.js imports at build time --
# needed inside the Docker build context (see dashboard/vite.config.js).
!dashboard/scripts/productionBuildGuard.mjs
inference-service/*_demo.py
inference-service/main_system.py
inference-service/test_policy.py
data/check_latest.py
retraining-service/results/

# Raw and processed training datasets (large; keep local)
data/CICIDS2017/
data/CICDDoS2019/
datasets/raw/
datasets/processed/

# Simulation files and runs
sim_*.py
simulation_portal/
simulation_runs/

# Deployment: secrets live in $DEPLOY_HOME outside the repository; these are a safety net
deployment/secrets/
deployment/.env.deploy
deployment/backups/
*.htpasswd
.deploy.lock
