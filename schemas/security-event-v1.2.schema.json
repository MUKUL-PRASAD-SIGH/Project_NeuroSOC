{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neurosoc:schema:security-event:1.2.0",
  "title": "NeuroSOC Security Event v1.2",
  "description": "Versioned Kafka event contract with tenant, source, correlation, and idempotency identifiers for shared multi-tenant processing.",
  "oneOf": [
    { "$ref": "#/$defs/networkPacket" },
    { "$ref": "#/$defs/networkFlow" }
  ],
  "$defs": {
    "networkPacket": {
      "type": "object",
      "required": [
        "schema_version", "tenant_id", "event_type", "packet_id", "timestamp", "src_ip", "dst_ip",
        "src_port", "dst_port", "protocol", "length", "flags", "ttl", "source",
        "source_id", "correlation_id", "idempotency_key"
      ],
      "properties": {
        "schema_version": { "const": "1.2" },
        "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "event_type": { "const": "network.packet" },
        "packet_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "number", "minimum": 0 },
        "src_ip": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dst_ip": { "type": "string", "minLength": 1, "maxLength": 64 },
        "src_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "dst_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "protocol": { "type": "string", "minLength": 1, "maxLength": 32 },
        "length": { "type": "integer", "minimum": 0 },
        "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "ttl": { "type": "integer", "minimum": 0, "maximum": 255 },
        "source": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 192 },
        "session_id": { "type": ["string", "null"], "maxLength": 128 },
        "user_id": { "type": ["string", "null"], "maxLength": 256 },
        "extra": { "type": "object" }
      },
      "additionalProperties": false
    },
    "networkFlow": {
      "type": "object",
      "required": [
        "schema_version", "tenant_id", "event_type", "flow_id", "timestamp", "src_ip", "dst_ip",
        "src_port", "dst_port", "protocol", "features", "raw_features", "n_packets",
        "source_id", "correlation_id", "idempotency_key"
      ],
      "properties": {
        "schema_version": { "const": "1.2" },
        "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "event_type": { "const": "network.flow" },
        "flow_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "number", "minimum": 0 },
        "src_ip": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dst_ip": { "type": "string", "minLength": 1, "maxLength": 64 },
        "src_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "dst_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "protocol": { "type": "string", "minLength": 1, "maxLength": 32 },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "correlation_id": { "type": ["string", "null"], "maxLength": 128 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 192 },
        "features": {
          "type": "array",
          "minItems": 80,
          "maxItems": 80,
          "items": { "type": "number" }
        },
        "raw_features": {
          "type": "array",
          "minItems": 80,
          "maxItems": 80,
          "items": { "type": "number" }
        },
        "n_packets": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
