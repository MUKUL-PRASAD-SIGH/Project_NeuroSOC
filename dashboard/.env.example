VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=false
VITE_DEV_MOCK_FALLBACK=false
VITE_ENABLE_MSW=false
# Enable only after the Colab model artifact and serving API are connected.
VITE_MODEL_INTEGRATION_ENABLED=false
# SDK Protection page (needs ENABLE_UNIVERSAL_ENGINE=true on the inference service)
VITE_UNIVERSAL_ENABLED=false

# Keycloak sign-in. VITE_OIDC_REQUIRED=false (default) leaves the dashboard usable without
# signing in, matching the backend's own opt-in OIDC_REQUIRED default.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=neurosoc
VITE_KEYCLOAK_CLIENT_ID=neurosoc-dashboard
VITE_OIDC_REQUIRED=false

# Optional local NovaTrust scenario credentials; keep real or shared credentials out of this file.
VITE_NOVATRUST_TRUSTED_PASSWORD=
VITE_NOVATRUST_REVIEW_PASSWORD=
